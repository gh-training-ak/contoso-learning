# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

COPY Directory.Build.props global.json ./
COPY src/Contoso.Domain/Contoso.Domain.csproj src/Contoso.Domain/
COPY src/Contoso.Application/Contoso.Application.csproj src/Contoso.Application/
COPY src/Contoso.Infrastructure/Contoso.Infrastructure.csproj src/Contoso.Infrastructure/
COPY src/Contoso.Api/Contoso.Api.csproj src/Contoso.Api/
RUN dotnet restore src/Contoso.Api/Contoso.Api.csproj

COPY . .
RUN dotnet publish src/Contoso.Api/Contoso.Api.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

RUN addgroup -g 10001 -S contoso \
 && adduser -u 10001 -S contoso -G contoso

COPY --from=build --chown=10001:10001 /app .

USER 10001
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz || exit 1

ENTRYPOINT ["dotnet", "Contoso.Api.dll"]
