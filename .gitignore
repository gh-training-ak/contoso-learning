# Build output
# Nothing under bin or obj belongs in history. Both are regenerated by a build.
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
TestResults/
*.trx
*.coverage
coverage.cobertura.xml

# Visual Studio and Rider
.vs/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates
_ReSharper*/

# VS Code: keep the shared files, ignore the personal ones.
# The negations matter. Without them the whole folder is ignored and the team
# loses the shared launch configuration.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json
project.fragment.lock.json

# Node
node_modules/
npm-debug.log*
yarn-error.log
.angular/cache/
web/dist/

# Terraform: state holds secrets in plain text, it never goes in git.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
tfplan
*.tfplan

# Secrets and local configuration.
# appsettings.Development.json is committed because it holds no secrets.
# Anything with Local in the name is yours and stays yours.
appsettings.Local.json
appsettings.*.Local.json
*.pfx
*.p12
*.key
.env
.env.*
!.env.example

# Operating system noise
.DS_Store
Thumbs.db
desktop.ini
*~

# Editors
*.swp
*.bak
*.orig
*.rej
